+static float3 shadeRoundedTerrainNormal(float3 cameraRelative, float3 cameraFract, float3 geometric, float radius)
+{
+    float3 a=abs(geometric);
+    if(max(max(a.x,a.y),a.z)>0.999 || radius<=0.0) return geometric;
