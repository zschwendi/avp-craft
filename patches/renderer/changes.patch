+    // A cylinder continuing across a block boundary has no curvature on its
+    // free axis; do not infer a spherical cap from that coordinate's fraction.
+    delta=select(float3(0.0),delta,a>float3(0.001));
+    float len2=dot(delta,delta);
+    if(len2<radius*radius*0.75 || len2>radius*radius*1.06) return geometric;
+    float3 smooth=delta*rsqrt(max(len2,1e-30));
+    return dot(smooth,geometric)>0.90 ? smooth : geometric;
