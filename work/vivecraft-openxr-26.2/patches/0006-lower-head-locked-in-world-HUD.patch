diff --git a/common/src/main/java/org/vivecraft/client_vr/gameplay/screenhandlers/HeadHudPitch.java b/common/src/main/java/org/vivecraft/client_vr/gameplay/screenhandlers/HeadHudPitch.java
new file mode 100644
index 00000000..17e0f7d1
--- /dev/null
+++ b/common/src/main/java/org/vivecraft/client_vr/gameplay/screenhandlers/HeadHudPitch.java
@@ -0,0 +1,126 @@
+package org.vivecraft.client_vr.gameplay.screenhandlers;
+
+import net.minecraft.world.phys.Vec3;
+import org.joml.Matrix4f;
+import org.joml.Matrix4fc;
+
+/**
+ * pitches the head locked in-game HUD around the head, about the HUD's own right axis.
+ * Never modifies its inputs, a pitched placement is always returned as new objects.
+ */
+public final class HeadHudPitch {
+    /**
+     * largest pitch offset applied in either direction, in degrees
+     */
+    public static final float MAX_PITCH_DEGREES = 45.0F;
+
+    // squared lengths below this are treated as degenerate
+    private static final double EPSILON_SQ = 1.0E-12D;
+
+    private HeadHudPitch() {}
+
+    /**
+     * position and orientation of the HUD quad, both are new objects owned by the caller
+     */
+    public record Placement(Vec3 position, Matrix4f rotation) {}
+
+    /**
+     * pitches the head locked HUD, but only the in-game HUD. Open screens (menus, inventory, also when forced onto
+     * the HUD) and the seated HUD that follows the controller aim keep their original placement.
+     *
+     * @param screenOpen   if a screen is open
+     * @param seatedAltAim if the seated HUD follows the controller aim instead of the head
+     * @param head         position the HUD orbits, the hmd position
+     * @param position     center of the HUD quad
+     * @param rotation     orientation of the HUD quad, local -Z points from the head to the HUD, not modified
+     * @param pitchDegrees pitch offset in degrees, negative lowers the HUD, clamped to +/-{@link #MAX_PITCH_DEGREES}
+     * @return the pitched placement, or {@code null} if the HUD keeps its original placement
+     */
+    public static Placement pitchInGameHud(
+        boolean screenOpen, boolean seatedAltAim, Vec3 head, Vec3 position, Matrix4fc rotation, float pitchDegrees)
+    {
+        if (screenOpen || seatedAltAim) {
+            return null;
+        }
+        return pitch(head, position, rotation, pitchDegrees);
+    }
+
+    /**
+     * rotates {@code position} around {@code head} and {@code rotation} by the same angle, about the right axis
+     * (local +X) of {@code rotation}. The distance to the head and the size of the quad stay the same.
+     *
+     * @param head         position the HUD orbits
+     * @param position     center of the HUD quad
+     * @param rotation     orientation of the HUD quad, not modified
+     * @param pitchDegrees pitch offset in degrees, negative lowers the HUD, clamped to +/-{@link #MAX_PITCH_DEGREES}
+     * @return the pitched placement, or {@code null} for a zero or non-finite angle, or invalid geometry
+     */
+    public static Placement pitch(Vec3 head, Vec3 position, Matrix4fc rotation, float pitchDegrees) {
+        if (head == null || position == null || rotation == null ||
+            !Float.isFinite(pitchDegrees) || pitchDegrees == 0.0F)
+        {
+            return null;
+        }
+        if (!isFinite(head) || !isFinite(position) || !isFiniteBasis(rotation)) {
+            return null;
+        }
+
+        double dx = position.x - head.x;
+        double dy = position.y - head.y;
+        double dz = position.z - head.z;
+        double radiusSq = dx * dx + dy * dy + dz * dz;
+
+        // head local right axis in world space
+        double ax = rotation.m00();
+        double ay = rotation.m01();
+        double az = rotation.m02();
+        double axisSq = ax * ax + ay * ay + az * az;
+
+        if (!Double.isFinite(radiusSq) || radiusSq < EPSILON_SQ || !Double.isFinite(axisSq) || axisSq < EPSILON_SQ) {
+            return null;
+        }
+
+        double invAxis = 1.0D / Math.sqrt(axisSq);
+        ax *= invAxis;
+        ay *= invAxis;
+        az *= invAxis;
+
+        double dot = ax * dx + ay * dy + az * dz;
+        // the HUD has to be in front of the head, not off to the side along the pitch axis
+        if (dot * dot > 0.5D * radiusSq) {
+            return null;
+        }
+
+        double radians = Math.toRadians(Math.max(-MAX_PITCH_DEGREES, Math.min(MAX_PITCH_DEGREES, pitchDegrees)));
+        double c = Math.cos(radians);
+        double s = Math.sin(radians);
+
+        // Rodrigues rotation of the head to HUD offset, matches the local rotateX of the quad below
+        double rx = dx * c + (ay * dz - az * dy) * s + ax * dot * (1.0D - c);
+        double ry = dy * c + (az * dx - ax * dz) * s + ay * dot * (1.0D - c);
+        double rz = dz * c + (ax * dy - ay * dx) * s + az * dot * (1.0D - c);
+
+        double x = head.x + rx;
+        double y = head.y + ry;
+        double z = head.z + rz;
+        if (!Double.isFinite(x) || !Double.isFinite(y) || !Double.isFinite(z)) {
+            return null;
+        }
+
+        Matrix4f pitchedRotation = new Matrix4f(rotation).rotateX((float) radians);
+        if (!isFiniteBasis(pitchedRotation)) {
+            return null;
+        }
+        return new Placement(new Vec3(x, y, z), pitchedRotation);
+    }
+
+    private static boolean isFinite(Vec3 vec) {
+        return Double.isFinite(vec.x) && Double.isFinite(vec.y) && Double.isFinite(vec.z);
+    }
+
+    private static boolean isFiniteBasis(Matrix4fc m) {
+        return Float.isFinite(m.m00()) && Float.isFinite(m.m01()) && Float.isFinite(m.m02()) &&
+            Float.isFinite(m.m10()) && Float.isFinite(m.m11()) && Float.isFinite(m.m12()) &&
+            Float.isFinite(m.m20()) && Float.isFinite(m.m21()) && Float.isFinite(m.m22());
+    }
+}
