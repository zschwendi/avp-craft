+++ b/common/src/main/java/org/vivecraft/client_vr/render/helpers/graphics/opengl/SwapchainLayerTexture.java
@@ -0,0 +1,61 @@
+package org.vivecraft.client_vr.render.helpers.graphics.opengl;
+
+import com.mojang.blaze3d.GpuFormat;
+import com.mojang.blaze3d.opengl.GlTexture;
+import com.mojang.blaze3d.opengl.GlTextureView;
+import com.mojang.blaze3d.textures.GpuTexture;
+import com.mojang.blaze3d.textures.GpuTextureView;
+
+/**
+ * Klepton (jar patch 0005, "direct post"): a blaze3d texture that IS one (image, layer) of the OpenXR
+ * swapchain, so the VR post pass can render straight into the swapchain instead of into the
+ * "L Eye"/"R Eye" targets that {@code blitTextures} then copies over.
+ * <p>
+ * blaze3d attaches render targets with {@code glFramebufferTexture2D}, which cannot name one layer of
+ * a GL_TEXTURE_2D_ARRAY. So this texture never goes through blaze3d's FBO cache: its view carries
+ * the framebuffer {@link OpenGLRawTexture#link} already built for the layer (with
+ * {@code glFramebufferTextureLayer}, exactly as the blit target always was), and
+ * {@code FrameBufferCacheMixin} hands that framebuffer to any render pass whose only colour
+ * attachment is this view. The swapchain image is owned by the runtime: closing this texture never
+ * deletes the GL name.
+ */
+public class SwapchainLayerTexture extends GlTexture {
+
+    private SwapchainLayerTexture(String label, GpuFormat format, int width, int height, int glImage) {
+        super(GpuTexture.USAGE_RENDER_ATTACHMENT | GpuTexture.USAGE_COPY_DST, label, format, width, height, 1, 1,
+            glImage, OpenGLHelper.getGlDevice().frameBufferCache());
+    }
+
+    /**
+     * wraps the layer {@code link} was built for as a render-target view
+     *
+     * @param label  debug name
+     * @param format the blaze3d format to report; the GL storage is whatever the runtime allocated
+     * @param link   the linked swapchain layer (its framebuffer is the one rendered into)
+     * @return a view that blaze3d render passes can target
+     */
+    public static GpuTextureView wrap(String label, GpuFormat format, OpenGLRawTexture link) {
+        SwapchainLayerTexture texture = new SwapchainLayerTexture(label, format, link.width, link.height,
+            (int) link.getHandle());
+        return new View(texture, link.getFbo());
+    }
+
+    @Override
+    public void close() {
+        // the runtime owns the image: mark closed, never glDeleteTextures it. Close the view FIRST
+        // (GlTexture#removeViews would otherwise delete the name once this is closed).
+        this.closed = true;
+    }
+
+    /**
+     * the render-target view; {@link #fbo} is the layer's framebuffer
+     */
+    public static class View extends GlTextureView {
+        public final int fbo;
+
+        private View(SwapchainLayerTexture texture, int fbo) {
+            super(texture, 0, 1, OpenGLHelper.getGlDevice().frameBufferCache());
+            this.fbo = fbo;
+        }
+    }
+}
