+package org.vivecraft.client_vr.render.helpers.graphics.opengl;
+
+import com.mojang.blaze3d.opengl.GlStateManager;
+import com.mojang.blaze3d.pipeline.RenderTarget;
+import com.mojang.blaze3d.systems.RenderSystem;
+import com.mojang.blaze3d.textures.GpuTextureView;
+import net.minecraft.client.Minecraft;
+import org.joml.Vector4f;
+import org.lwjgl.opengl.GL11C;
+import org.lwjgl.opengl.GL12C;
+import org.lwjgl.opengl.GL30C;
+import org.lwjgl.system.MemoryStack;
+import org.vivecraft.api.client.data.RenderPass;
+import org.vivecraft.client_vr.VRTextureTarget;
+import org.vivecraft.client_vr.render.VRShaders;
+import org.vivecraft.client_vr.render.helpers.ShaderHelper;
+import org.vivecraft.client_vr.render.helpers.graphics.GraphicsHelper;
+import org.vivecraft.client_vr.render.helpers.graphics.ImageFormat;
+import org.vivecraft.client_vr.render.renderstates.PostProcessRenderState;
+import org.vivecraft.client_vr.render.ubos.PostProcessUBO;
+import org.vivecraft.client_vr.settings.VRSettings;
+
+import java.nio.ByteBuffer;
+
+/**
+ * Klepton (jar patch 0005): a flat-mode check of the "direct post" machinery on whatever GL the game runs on,
+ * since the VR path itself cannot run without a headset runtime. With {@code -Dvivecraft.klepton.directpost.selftest=true}
+ * it runs once, on the render thread, 30 flat frames after the resource-load overlay is gone:
+ * <ol>
+ *   <li>a GL_TEXTURE_2D_ARRAY SRGB8_ALPHA8 texture with 2 layers stands in for the OpenXR swapchain image, each
+ *   layer linked through {@link OpenGLRawTexture#link} (glFramebufferTextureLayer), exactly as OpenXRStereoRenderer
+ *   links the real one;</li>
+ *   <li>layer 0 gets Vivecraft's real VR post pass straight into a {@link SwapchainLayerTexture} view (0005);</li>
+ *   <li>layer 1 gets upstream's path: the same post pass into an RGBA8 "eye" target, then
+ *   {@code GraphicsHelper.blitTextures} into the layer;</li>
+ *   <li>both layers are read back at 5 points and compared, and the GL error state is checked.</li>
+ * </ol>
+ * One log line, {@code [klepton] direct post self-test: … PASS|FAIL}. Inert without the property.
+ */
+public final class DirectPostSelfTest {
+    private static final boolean ENABLED = Boolean.getBoolean("vivecraft.klepton.directpost.selftest");
+    private static final int RUN_AT_FRAME = 30;
+    private static final int SIZE = 64;
+    private static int frames;
+
+    private DirectPostSelfTest() {}
+
+    /**
+     * called every flat-mode frame from the mirror blit; does nothing unless the property is set
+     */
+    public static void tick() {
+        if (!ENABLED || frames > RUN_AT_FRAME) return;
+        // count only frames after the resource load (the post shader comes from Vivecraft's resources)
+        if (Minecraft.getInstance().gui.overlay() != null) return;
+        if (++frames == RUN_AT_FRAME) {
+            try {
+                run();
+            } catch (Throwable t) {
+                VRSettings.LOGGER.error("Vivecraft: [klepton] direct post self-test: FAIL (threw)", t);
+            }
+        }
+    }
+
+    private static void run() {
+        while (GL11C.glGetError() != GL11C.GL_NO_ERROR) {}
+
+        // the stand-in swapchain image: SRGB8_ALPHA8, 2 layers (kl_openxr lists SRGB8_ALPHA8 first)
+        int array = GlStateManager._genTexture();
+        GL11C.glBindTexture(GL30C.GL_TEXTURE_2D_ARRAY, array);
+        GL12C.glTexImage3D(GL30C.GL_TEXTURE_2D_ARRAY, 0, GL30C.GL_SRGB8_ALPHA8, SIZE, SIZE, 2, 0, GL11C.GL_RGBA,
+            GL11C.GL_UNSIGNED_BYTE, (ByteBuffer) null);
+        GL11C.glTexParameteri(GL30C.GL_TEXTURE_2D_ARRAY, GL11C.GL_TEXTURE_MIN_FILTER, GL11C.GL_NEAREST);
+        GL11C.glTexParameteri(GL30C.GL_TEXTURE_2D_ARRAY, GL11C.GL_TEXTURE_MAG_FILTER, GL11C.GL_NEAREST);
+        GL11C.glBindTexture(GL30C.GL_TEXTURE_2D_ARRAY, 0);
+
+        OpenGLRawTexture layer0 = OpenGLRawTexture.link("selftest layer 0", SIZE, SIZE, ImageFormat.R8G8B8A8_SRGB,
+            array, 0);
+        OpenGLRawTexture layer1 = OpenGLRawTexture.link("selftest layer 1", SIZE, SIZE, ImageFormat.R8G8B8A8_SRGB,
+            array, 1);
+        int setupError = GL11C.glGetError();
+
+        // the "3D Render" stand-in: a 4-colour quadrant pattern, so a flip or offset would show
+        VRTextureTarget source = VRTextureTarget.builder("selftest source").withSize(SIZE, SIZE).build();
+        VRTextureTarget eye = VRTextureTarget.builder("selftest eye").withSize(SIZE, SIZE).build();
+        fillQuadrants(source);
+
+        boolean ownUbo = VRShaders.POST_PROCESS_UBO == null;
+        if (ownUbo) VRShaders.POST_PROCESS_UBO = new PostProcessUBO();
+        PostProcessRenderState state = new PostProcessRenderState();
+
+        GpuTextureView direct = SwapchainLayerTexture.wrap("selftest direct", eye.gpuFormat, layer0);
+
+        // 0005: post pass straight into layer 0
+        ShaderHelper.doVrPostProcess(RenderPass.LEFT, source, direct, state);
+        // upstream: post pass into the eye target, then blitTextures into layer 1
+        ShaderHelper.doVrPostProcess(RenderPass.LEFT, source, eye, state);
+        GraphicsHelper.INSTANCE.blitTextures(new RenderTarget[]{eye}, layer1);
+        RenderSystem.getDevice().createCommandEncoder().submit();
+
+        int drawError = GL11C.glGetError();
+
+        int[][] points = {{SIZE / 4, SIZE / 4}, {3 * SIZE / 4, SIZE / 4}, {SIZE / 4, 3 * SIZE / 4},
+            {3 * SIZE / 4, 3 * SIZE / 4}, {SIZE / 2 + 1, SIZE / 2 + 1}};
+        StringBuilder sb = new StringBuilder();
+        boolean same = true;
+        boolean lit = false;
+        for (int[] p : points) {
+            int a = readPixel(layer0.getFbo(), p[0], p[1]);
+            int b = readPixel(layer1.getFbo(), p[0], p[1]);
+            same &= a == b;
+            lit |= (a & 0xFFFFFF) != 0;
+            sb.append(String.format(" (%d,%d) direct %08x blit %08x", p[0], p[1], a, b));
+        }
+        int readError = GL11C.glGetError();
+
+        // cleanup, view before texture (closing never deletes the GL name)
+        direct.close();
+        direct.texture().close();
+        layer0.destroy();
+        layer1.destroy();
+        GlStateManager._deleteTexture(array);
+        source.destroyBuffers();
+        eye.destroyBuffers();
+        if (ownUbo) {
+            VRShaders.POST_PROCESS_UBO.close();
+            VRShaders.POST_PROCESS_UBO = null;
+        }
+
+        boolean pass = same && lit && setupError == 0 && drawError == 0 && readError == 0;
+        VRSettings.LOGGER.info(
+            "Vivecraft: [klepton] direct post self-test: {} — layer 0 (post pass into a SwapchainLayerTexture view) vs "
+                + "layer 1 (post pass into RGBA8 + blitTextures), {}x{} SRGB8_ALPHA8 array:{}; GL errors setup 0x{} draw 0x{} read 0x{}",
+            pass ? "PASS" : "FAIL", SIZE, SIZE, sb, Integer.toHexString(setupError), Integer.toHexString(drawError),
+            Integer.toHexString(readError));
+    }
+
+    private static void fillQuadrants(VRTextureTarget target) {
+        // clear the whole target, then 3 scissored clears through a throwaway FBO for the other quadrants
+        RenderSystem.getDevice().createCommandEncoder()
+            .clearColorTexture(target.getColorTexture(), new Vector4f(0.25F, 0.5F, 0.75F, 1.0F));
+        RenderSystem.getDevice().createCommandEncoder().submit();
+        int fbo = GlStateManager.glGenFramebuffers();
+        int oldDraw = GlStateManager.getFrameBuffer(GL30C.GL_DRAW_FRAMEBUFFER);
+        GlStateManager._glBindFramebuffer(GL30C.GL_DRAW_FRAMEBUFFER, fbo);
+        GlStateManager._glFramebufferTexture2D(GL30C.GL_DRAW_FRAMEBUFFER, GL30C.GL_COLOR_ATTACHMENT0,
+            GL11C.GL_TEXTURE_2D, (int) GraphicsHelper.INSTANCE.getTextureHandle(target.getColorTexture()), 0);
+        GL11C.glEnable(GL11C.GL_SCISSOR_TEST);
+        float[][] colours = {{1.0F, 0.0F, 0.0F}, {0.0F, 1.0F, 0.0F}, {0.6F, 0.6F, 0.1F}};
+        int[][] origins = {{SIZE / 2, 0}, {0, SIZE / 2}, {SIZE / 2, SIZE / 2}};
+        for (int i = 0; i < 3; i++) {
+            GL11C.glScissor(origins[i][0], origins[i][1], SIZE / 2, SIZE / 2);
+            GL11C.glClearColor(colours[i][0], colours[i][1], colours[i][2], 1.0F);
+            GL11C.glClear(GL11C.GL_COLOR_BUFFER_BIT);
+        }
+        GL11C.glDisable(GL11C.GL_SCISSOR_TEST);
+        GlStateManager._glBindFramebuffer(GL30C.GL_DRAW_FRAMEBUFFER, oldDraw);
+        GlStateManager._glDeleteFramebuffers(fbo);
+    }
+
+    private static int readPixel(int fbo, int x, int y) {
+        int oldRead = GlStateManager.getFrameBuffer(GL30C.GL_READ_FRAMEBUFFER);
+        GlStateManager._glBindFramebuffer(GL30C.GL_READ_FRAMEBUFFER, fbo);
+        int rgba;
+        try (MemoryStack stack = MemoryStack.stackPush()) {
+            ByteBuffer px = stack.calloc(4);
+            GL11C.glReadPixels(x, y, 1, 1, GL11C.GL_RGBA, GL11C.GL_UNSIGNED_BYTE, px);
+            rgba = (px.get(0) & 0xFF) << 24 | (px.get(1) & 0xFF) << 16 | (px.get(2) & 0xFF) << 8 | px.get(3) & 0xFF;
+        }
+        GlStateManager._glBindFramebuffer(GL30C.GL_READ_FRAMEBUFFER, oldRead);
+        return rgba;
+    }
+}
