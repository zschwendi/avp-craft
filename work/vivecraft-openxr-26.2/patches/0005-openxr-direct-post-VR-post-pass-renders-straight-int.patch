@@ -0,0 +1,34 @@
+package org.vivecraft.mixin.client_vr.blaze3d.opengl;
+
+import com.mojang.blaze3d.opengl.DirectStateAccess;
+import com.mojang.blaze3d.opengl.FrameBufferAttachment;
+import com.mojang.blaze3d.opengl.FrameBufferCache;
+import org.spongepowered.asm.mixin.Mixin;
+import org.spongepowered.asm.mixin.injection.At;
+import org.spongepowered.asm.mixin.injection.Inject;
+import org.spongepowered.asm.mixin.injection.callback.CallbackInfoReturnable;
+import org.vivecraft.client_vr.render.helpers.graphics.opengl.SwapchainLayerTexture;
+
+import java.util.List;
+
+/**
+ * Klepton (jar patch 0005, "direct post"): a render pass whose only colour attachment is an OpenXR
+ * swapchain layer renders into the framebuffer that layer was linked with
+ * ({@code glFramebufferTextureLayer}). blaze3d's own cache would attach the array texture with
+ * {@code glFramebufferTexture2D}, which cannot name a layer.
+ */
+@Mixin(FrameBufferCache.class)
+public class FrameBufferCacheVRMixin {
+
+    @Inject(method = "getFbo", at = @At("HEAD"), cancellable = true)
+    private void vivecraft$swapchainLayerFbo(
+        DirectStateAccess dsa, List<FrameBufferAttachment> colorAttachments, FrameBufferAttachment depthAttachment,
+        CallbackInfoReturnable<Integer> cir)
+    {
+        if (depthAttachment == null && colorAttachments.size() == 1 &&
+            colorAttachments.get(0) instanceof SwapchainLayerTexture.View view)
+        {
+            cir.setReturnValue(view.fbo);
+        }
+    }
+}
